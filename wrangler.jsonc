{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "cs2-elo",
    "compatibility_date": "2026-09-15",
    "routes": [
        {
            "pattern": "esports.daviddecorso.com",
            "custom_domain": true
        }
    ],
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page"
    }
}
